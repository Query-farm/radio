# name: test/sql/radio_external_access.test
# description: Network transports refuse to run when enable_external_access is false
# group: [radio]

require radio

statement ok
CALL radio_subscribe('ws://127.0.0.1:1')

statement ok
PREPARE late_subscribe AS SELECT * FROM radio_subscribe('ws://127.0.0.1:2')

statement ok
SET enable_external_access = false

statement error
CALL radio_subscribe('ws://127.0.0.1:3')
----
Permission Error: radio_subscribe is disabled because enable_external_access is false

statement error
CALL radio_subscribe('redis://127.0.0.1:1?channel=x')
----
Permission Error: radio_subscribe is disabled because enable_external_access is false

statement error
EXECUTE late_subscribe
----
Permission Error: radio_subscribe is disabled because enable_external_access is false

statement error
CALL radio_transmit_message('ws://127.0.0.1:1', NULL, 'x', 1, INTERVAL '1 minute')
----
Permission Error: radio_transmit_message is disabled because enable_external_access is false

# The loopback transport never touches the network, so it stays available.
query I
SELECT * FROM radio_subscribe('loopback://sandboxed')
----
1

query I
SELECT * FROM radio_transmit_message('loopback://sandboxed', NULL, 'local', 1, INTERVAL '1 minute')
----
1000

# Local inspection still works.
query I
SELECT count(*) FROM radio_subscriptions()
----
2

statement ok
CALL radio_unsubscribe('ws://127.0.0.1:1')

statement ok
CALL radio_unsubscribe('loopback://sandboxed')
