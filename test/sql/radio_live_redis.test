# name: test/sql/radio_live_redis.test
# description: Round trip through a real Redis server (set RADIO_TEST_REDIS_HOST=host:port to run)
# group: [radio]

require radio

require-env RADIO_TEST_REDIS_HOST

statement ok
CALL radio_subscribe('redis://{RADIO_TEST_REDIS_HOST}?channel=radio_live_test')

# The SUBSCRIBE is issued by a background thread; give it time to become active.
statement ok
CALL radio_sleep(INTERVAL '1 second')

query I
SELECT activation_time IS NOT NULL FROM radio_subscriptions()
----
true

query I
SELECT * FROM radio_transmit_message('redis://{RADIO_TEST_REDIS_HOST}?channel=radio_live_test', 'radio_live_test', 'hello redis', 3, INTERVAL '10 seconds')
----
1000

query I
SELECT * FROM radio_flush(INTERVAL '10 seconds')
----
true

query I
SELECT subscription_id FROM radio_listen(true, INTERVAL '10 seconds')
----
0

query III
SELECT message_type, channel, message::VARCHAR FROM radio_received_messages()
----
message	radio_live_test	hello redis

query II
SELECT state, try_count FROM radio_subscription_transmit_messages('redis://{RADIO_TEST_REDIS_HOST}?channel=radio_live_test')
----
sent	1

# Redis transmit without a channel fails the message instead of crashing.
statement ok
CALL radio_transmit_message('redis://{RADIO_TEST_REDIS_HOST}?channel=radio_live_test', NULL, 'no channel', 1, INTERVAL '10 seconds')

statement ok
CALL radio_flush(INTERVAL '10 seconds')

query II
SELECT state, result::VARCHAR FROM radio_subscription_transmit_messages('redis://{RADIO_TEST_REDIS_HOST}?channel=radio_live_test') WHERE message::VARCHAR = 'no channel'
----
retries_exhausted	Redis transmit requires a channel

statement ok
CALL radio_unsubscribe('redis://{RADIO_TEST_REDIS_HOST}?channel=radio_live_test')
