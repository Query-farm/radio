# name: test/sql/radio_parameter_names.test
# description: duckdb_functions() reports the real parameter names, and calls stay positional
# group: [sql]

require radio

query TT
SELECT function_name, parameters FROM duckdb_functions()
WHERE function_name LIKE 'radio%'
ORDER BY function_name, parameter_types::VARCHAR;
----
radio_flush	[timeout]
radio_listen	[wait_for_messages, timeout]
radio_received_messages	[]
radio_sleep	[duration]
radio_subscribe	[url, receive_message_capacity, transmit_retry_initial_delay_ms, transmit_retry_multiplier, transmit_retry_max_delay_ms]
radio_subscription_received_message_add	[url, channel, message]
radio_subscription_received_messages	[url]
radio_subscription_transmit_message_delete	[url, message_id]
radio_subscription_transmit_messages	[url]
radio_subscription_transmit_messages_delete_finished	[url]
radio_subscriptions	[]
radio_transmit_message	[url, channel, message, max_attempts, expire_duration]
radio_transmit_message	[url, channel, message, max_attempts, expire_duration]
radio_unsubscribe	[url]
radio_version	[]

# A positional call still works
query I
SELECT * FROM radio_sleep(INTERVAL '1 millisecond');
----
true
