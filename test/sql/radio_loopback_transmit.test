# name: test/sql/radio_loopback_transmit.test
# description: Transmit queue, flush and delete functions over the offline loopback transport
# group: [radio]

require radio

statement ok
CALL radio_subscribe('loopback://tx')

query I
SELECT * FROM radio_transmit_message('loopback://tx', 'news', 'first', 3, INTERVAL '1 minute')
----
1000

# Message ids come from one counter shared with the loopback deliveries, so
# only the first is predictable.
statement ok
CALL radio_transmit_message('loopback://tx', NULL, '\x01\x02'::BLOB, 3, INTERVAL '1 minute')

query I
SELECT * FROM radio_flush(INTERVAL '10 seconds')
----
true

query IIIII
SELECT state, try_count, max_attempts, channel, octet_length(message)
FROM radio_subscription_transmit_messages('loopback://tx') ORDER BY message_id
----
sent	1	3	news	5
sent	1	3	NULL	2

# Transmitted messages come back on the loopback subscription.
query II
SELECT channel, octet_length(message) FROM radio_received_messages() ORDER BY message_id
----
news	5
NULL	2

query III
SELECT transmit_messages_processed, transmit_successes, transmit_failures FROM radio_subscriptions()
----
2	2	0

statement ok
CALL radio_subscription_transmit_messages_delete_finished('loopback://tx')

query I
SELECT count(*) FROM radio_subscription_transmit_messages('loopback://tx')
----
0

# Delete a single transmit message by id.
statement ok
CALL radio_subscribe('loopback://del')

query I
SELECT * FROM radio_transmit_message('loopback://del', NULL, 'to delete', 1, INTERVAL '1 minute')
----
1000

query I
SELECT * FROM radio_subscription_transmit_message_delete('loopback://del', 1000)
----
true

query I
SELECT count(*) FROM radio_subscription_transmit_messages('loopback://del')
----
0

statement ok
CALL radio_unsubscribe('loopback://del')

# A message queued on a subscription that never connects stays pending, so flush times out.
statement ok
CALL radio_subscribe('ws://127.0.0.1:1')

statement ok
CALL radio_transmit_message('ws://127.0.0.1:1', NULL, 'never sent', 100, INTERVAL '1 hour')

query I
SELECT * FROM radio_flush(INTERVAL '10 milliseconds')
----
false

query I
SELECT count(*) FROM radio_subscription_transmit_messages('ws://127.0.0.1:1') WHERE state IN ('pending', 'sending')
----
1

statement ok
CALL radio_unsubscribe('ws://127.0.0.1:1')

# Wake-ups are not lost: a message delivered by the sender thread while radio_listen is
# scanning or about to wait must be returned, not slept through until the timeout.
loop i 0 25

statement ok
CALL radio_received_messages()

statement ok
CALL radio_transmit_message('loopback://tx', NULL, 'wake ' || ${i}, 1, INTERVAL '1 minute')

query II
SELECT * FROM radio_listen(true, INTERVAL '30 seconds')
----
0	loopback://tx

endloop

statement ok
CALL radio_unsubscribe('loopback://tx')
